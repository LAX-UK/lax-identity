{
  "name": "auction-identity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter @auction/auth-app... --workspace-concurrency=1 build",
    "lint": "biome check .",
    "lint:layers": "node scripts/check-layers.mjs",
    "typecheck": "pnpm --filter @auction/auth-app... --workspace-concurrency=1 typecheck",
    "test": "pnpm test:unit",
    "test:unit": "corepack pnpm@10.34.5 --filter @auction/auth-app... --workspace-concurrency=1 --if-present test --exclude='**/*.integration.test.ts'",
    "ci:identity-extractability": "node scripts/ci/verify-identity-extractability.mjs",
    "ci:verify": "pnpm lint && pnpm lint:layers && pnpm ci:identity-extractability && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.13.5 <1.18.0": "1.18.0",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "engine.io@>=6.5.0 <6.6.7": "6.6.7",
      "fast-xml-builder@<=1.1.6": "1.1.7",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "pg>pg-cloudflare": "-",
      "postcss@<=8.5.17": "8.5.18",
      "sharp@<0.35.0": "0.35.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "better-auth@1.6.22": "patches/better-auth@1.6.22.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
